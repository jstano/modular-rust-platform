# Copy to .env (this directory) to run `stano-example-app` and its tests against a
# local Postgres started via `docker compose up -d`. `OsEnvironment::new()` loads `.env`
# automatically via `dotenvy`, and `cargo test`/`cargo run` both run with this directory
# as the working directory. Never commit `.env`.

DATABASE_URL=postgres://postgres:postgres@localhost:5433/stano_example_app
